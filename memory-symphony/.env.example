# Copy this file to .env and fill in your key.
# .env is gitignored — the key is read by the backend only and is never sent
# to the React client.

ANTHROPIC_API_KEY=your_key_here

# Port for the backend API (the Vite dev server proxies /api here).
PORT=8787

# --- Experimental tuning (optional) ---------------------------------------
# Sets the STARTING values only; override per-session from the browser console
# (window.memorySymphony.setIntensity(0.3)) or via ?intensity=0.3 in the URL.
#
# Only VITE_-prefixed vars are exposed to the browser, so ANTHROPIC_API_KEY
# above stays server-side.
#
# How far the engine travels toward Claude's target state on each new memory.
#   0 = frozen | 0.25 = barely perceptible | 1 = as composed (default) | 2 = exaggerated
# VITE_CHANGE_INTENSITY=1
#
# Multiplies every fade, parameter ramp and pivot length.
#   0.5 = twice as fast | 1 = as composed (default) | 3 = very slow and smooth
# VITE_TRANSITION_SCALE=1
#
# How often the score modulates on its own, between memories.
#   0 = only when a memory arrives | 0.5 = every 2 cycles (default) | 1 = every cycle
# VITE_KEY_MOVEMENT=0.5
